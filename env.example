# ── Network ──────────────────────────────────────────────────────────────────
NETUID=1
SUBTENSOR_NETWORK=test          # test | finney | local
SUBTENSOR_ADDRESS=127.0.0.1:9944

# ── Wallet ───────────────────────────────────────────────────────────────────
WALLET_NAME=default
HOTKEY_NAME=default

# ── Validator ────────────────────────────────────────────────────────────────
VALIDATOR_PORT=8000
VALIDATOR_HOST=0.0.0.0
MIN_STAKE_THRESHOLD=2
CHALLENGE_INTERVAL_MINUTES=12   # one challenge round per Bittensor tempo (~100 blocks)
DB_PATH=validator.db
VERSION_KEY=1000

# ── Miner ────────────────────────────────────────────────────────────────────
MINER_PORT=8001
REFRESH_NODES=true
LOAD_OLD_NODES=true

# ── Satellite (Planetary Computer — no key needed for public data) ────────────
# Set PC_SDK_SUBSCRIPTION_KEY if you have a Planetary Computer subscription
# for higher rate limits. Leave blank for anonymous access.
# PC_SDK_SUBSCRIPTION_KEY=

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
