FROM python:3.11-slim

RUN apt-get update && apt-get install -y \
    build-essential \
    libgdal-dev \
    gdal-bin \
    libssl-dev \
    curl \
    git \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml setup.py ./
COPY miner/ miner/

RUN pip install --no-cache-dir -e ".[miner]"

EXPOSE 8001

CMD ["uvicorn", "miner.main:app", "--host", "0.0.0.0", "--port", "8001"]
