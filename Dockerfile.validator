FROM python:3.11-slim

RUN apt-get update && apt-get install -y \
    build-essential \
    libssl-dev \
    curl \
    git \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml setup.py ./
COPY validator/ validator/

RUN pip install --no-cache-dir -e ".[validator]"

CMD ["python", "-m", "validator.main"]
